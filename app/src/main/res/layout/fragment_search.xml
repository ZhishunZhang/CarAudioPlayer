<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding"
    android:paddingEnd="@dimen/page_padding"
    android:paddingTop="@dimen/page_padding">

    <!-- 搜索输入行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_keyword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search_box"
            android:hint="搜索歌曲 / 歌手"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/btn_voice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_search_box"
            android:contentDescription="语音搜索"
            android:padding="13dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/playing_tint" />

        <TextView
            android:id="@+id/btn_search"
            android:layout_width="112dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 热词 / 联想区标题 -->
    <TextView
        android:id="@+id/tv_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="热门搜索"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <!-- 热搜词横条（默认态） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_hotkeys"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never" />

    <!-- 联想结果列表（输入态） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_suggest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>